# Copy this file to .env and fill in your own keys:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# --- Matilda (Maincode) ----------------------------------------------------
# Needed for both rerun options. Get a key from Maincode's Matilda platform; it starts with mc_live_.
MATILDA_API_KEY=mc_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Gemini (Google) -------------------------------------------------------
# Needed for both rerun options. Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Hashtag AI ------------------------------------------------------------
# Only needed for option B (your own ingestion + search). Option A reuses results/search.json.
# Use the API key of your Hashtag project; it is sent as the x-api-key header.
HASHTAG_API_KEY=your-hashtag-project-api-key

# Your Hashtag project's base URL (the part before /search, /query or /process).
# Defaults to the original project, which needs that project's key.
# HOP_BASE_URL=https://kg-api-dev.hashtag.ai/<user>/<project>

# Optional: folder for a rerun's results, so the published results/ stay untouched.
# HOP_RESULTS_DIR=reruns/my-run
